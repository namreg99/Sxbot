# $200 CAD / ~145 USDC live smoke. Copy these into the Linode .env.
# Do not commit keys. Do not run this on the Cursor cloud VM.
#
# Convert CAD → USDC on your exchange, then send USDC to the SX *proxy*
# wallet (the one sx.bet shows as the trading balance), not the EOA.
#
# Leave SX_DRY_RUN=true until: `pip install -e ".[trade]"`, `sxbot doctor`
# prints min order 1 USDC, keys are on this box only, and the proxy is funded.
# Go live with either `SX_DRY_RUN=false` in .env OR: `python -m sxbot run --live`
# Do not start `sxbot mm`.

# Same unique-follow signals as the $5 paper card. Live dollars: $1 floor, $4 cap.
# Kelly $1 skip / $4 when grade is on is the size for ATP shorts and tennis dogs.
# Soccer favs 1.12–1.80 stay on that Kelly size. Soccer pick'em 1.80–2.20 is off.
# soccer_dog / mlb_dog (2.20–3.50, steam/rotation only) stay flat $1 — no unique
# W–L yet, so no $4 Kelly / $3 top-up. MLB dogs are moneyline only, not spreads.
# take_first: take Rangers (same team) whenever the other side is hittable; else join.
# `sxbot run --live` forces take_first even if .env still says join.
# $5 unique + $25 Kelly shadow are still stamped on every row for tracking.
# Real-money rows go to sxbot-live-*.jsonl (separate from the paper unique card).
SX_STAKE_USDC=1
SX_MAX_PER_MARKET_USDC=4
SX_MAX_OPEN_MARKETS=120
SX_MAX_EXPOSURE_USDC=120
SX_BANKROLL_USDC=1000
SX_KELLY_FRACTION=0.625
SX_MAX_ORDER_DECIMAL=3.5
SX_JOIN_TOB_LAG=false
SX_TOB_LAG_MAX_DECIMAL=2.20
SX_ALLOW_LIVE=false
# take_first: take the same team (IOC). No resting maker offers.
# Tennis dogs (2.20–3.50) are in the unique-follow universe, same as paper.
# Soccer/MLB steam dogs log to sxbot-live-soccer_dog.jsonl / sxbot-live-mlb_dog.jsonl.
# Do not set SX_SKIP_STYLES=tennis_dog — `run --live` strips that skip anyway.
SX_FOLLOW_STYLE=take_first
SX_KELLY_ON_TAKES=false
SX_KELLY_LIVE_CAP=true
SX_DRY_RUN=true
