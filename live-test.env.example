# $200 CAD / ~145 USDC live smoke. Copy these into the Linode .env.
# Do not commit keys. Do not run this on the Cursor cloud VM.
#
# Convert CAD → USDC on your exchange, then send USDC to the SX *proxy*
# wallet (the one sx.bet shows as the trading balance), not the EOA.
#
# Leave SX_DRY_RUN=true until: `pip install -e ".[trade]"`, `sxbot doctor`
# prints min order 1 USDC, keys are on this box only, and the proxy is funded.
# Go live with either `SX_DRY_RUN=false` in .env OR: `python -m sxbot run --live`
# Do not start `sxbot mm`.

# Same unique-follow games as the $5 paper card.
# Live size: $1 floor (was $5), $4 cap (was $25). Kelly still logged as shadow.
# No-edge unique still bets $1 (the 89 Kelly skips stay on the unique book).
SX_STAKE_USDC=1
SX_MAX_PER_MARKET_USDC=4
SX_MAX_OPEN_MARKETS=120
SX_MAX_EXPOSURE_USDC=120
# ⅝ Kelly math on the same $1000 paper bankroll as the shadow card, then cap $4.
SX_BANKROLL_USDC=1000
SX_KELLY_FRACTION=0.625
SX_MAX_ORDER_DECIMAL=2.20
SX_TOB_LAG_MAX_DECIMAL=2.20
SX_SKIP_STYLES=tennis_dog
SX_ALLOW_LIVE=false
SX_FOLLOW_STYLE=join
SX_KELLY_ON_TAKES=false
SX_KELLY_LIVE_CAP=true
SX_DRY_RUN=true
