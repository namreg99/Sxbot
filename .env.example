# Copy to .env. Never commit real keys.

# Real books are on mainnet. Before August 25, 2026 10:00 AM EST the bot
# aggregates V2 GET /orders into the V3 book shape (addresses ignored).
# After cutover the same URL serves V3 snapshots.
#   Mainnet: https://api.sx.bet
#   Testnet: https://api.toronto.sx.bet  (dummy books — not for paper P&L)
SX_API_BASE=https://api.sx.bet
# auto | v2 | v3
SX_BOOK_SOURCE=auto

# Required only for live order placement / cancel / heartbeat.
# Generate at sx.bet → account → API keys. Private key is on the assets page.
SX_API_KEY=
SX_PRIVATE_KEY=

# true = log intended orders, never submit. Keep this on until the paper log looks sane.
SX_DRY_RUN=true

# Quote size per join/take. Mainnet minimum is currently 5 USDC.
SX_STAKE_USDC=5

# Comma-separated sport ids. 8=Football, 1=Basketball, 3=Baseball, 2=Hockey, 5=Soccer.
SX_SPORT_IDS=8,1,3,2,5

# Optional league filter, e.g. 243=NFL, 1=NBA. Empty = all leagues in the sports list.
SX_LEAGUE_IDS=

# Only moneyline / spread / total main lines by default.
SX_ONLY_MAIN_LINE=true
# Watch in-play books for intel. Orders on live markets stay off unless SX_ALLOW_LIVE=true.
SX_WATCH_LIVE=true
SX_ALLOW_LIVE=false

# 100 bps = 1.00 implied-probability point.
SX_MIN_SPREAD_BPS=50
SX_MIN_MID_MOVE_BPS=20
SX_MIN_IMBALANCE=0.15
SX_JOIN_TICKS_BEHIND=1

SX_MAX_OPEN_MARKETS=8
SX_MAX_MARKETS=80
SX_MAX_EXPOSURE_USDC=100
SX_MAX_PER_MARKET_USDC=25
SX_POLL_SECONDS=2
SX_HEARTBEAT_SECONDS=60

SX_ENABLE_TAKE_STALE=true
SX_ENABLE_JOIN_MAKER=true
# join = sit behind makers (default)
# take = hit the informed side now (taker clone)
# mixed = take on strong steam, otherwise join
SX_FOLLOW_STYLE=join

# Your known sharp wallets. Visible on V2 only until Aug 25.
# After V3 the addresses vanish; `sxbot sharp` learns their habits (maker vs taker).
SX_SHARP_WALLETS=
SX_SHARP_LOG=sxbot-sharp.jsonl

SX_PAPER_LOG=sxbot-paper.jsonl
SX_FLOW_LOG=sxbot-flow.jsonl
SX_MIN_STEAM_HITS=2
