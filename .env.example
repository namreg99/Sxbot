# Copy to .env. Never commit real keys.

# Real books are on mainnet. Before August 25, 2026 10:00 AM EST the bot
# aggregates V2 GET /orders into the V3 book shape (addresses ignored).
# After cutover the same URL serves V3 snapshots.
#   Mainnet: https://api.sx.bet
#   Testnet: https://api.toronto.sx.bet  (dummy books — not for paper P&L)
SX_API_BASE=https://api.sx.bet
# auto | v2 | v3
SX_BOOK_SOURCE=auto

# Required only for live order placement / cancel / heartbeat.
# Generate at sx.bet → account → API keys. Private key is on the assets page.
SX_API_KEY=
SX_PRIVATE_KEY=

# true = log intended orders, never submit. Keep this on until the paper log looks sane.
SX_DRY_RUN=true

# Quote size per join/take. Mainnet minimum is currently 5 USDC.
SX_STAKE_USDC=5

# Comma-separated sport ids. 8=Football, 1=Basketball, 3=Baseball, 2=Hockey, 5=Soccer, 6=Tennis.
SX_SPORT_IDS=8,1,3,2,5,6

# Optional league filter, e.g. 243=NFL, 1=NBA. Empty = all leagues in the sports list.
SX_LEAGUE_IDS=

# Only moneyline / spread main lines by default (includes soccer type 1).
# Totals and "Not tie" are skipped for orders even if you add those types.
SX_ONLY_MAIN_LINE=true
SX_SKIP_TOTALS=true
SX_SKIP_NOT_TIE=true
SX_JOIN_TOB_LAG=false
SX_ONE_SIDE_PER_MARKET=true
# Team vs Not Team are different market hashes. Block both on the same event.
SX_ONE_SIDE_PER_EVENT=true
# Paper joins free their cap slot after this many seconds (or at kickoff).
# tennis_dog keeps the slot through kickoff so a live reverse can exit.
SX_PAPER_SLOT_SECONDS=7200
SX_TENNIS_DOG_LIVE_HOURS=5
# Do not join/take longer than this (same cap as mimic). 19% tennis dogs are 5+ decimal.
SX_MAX_ORDER_DECIMAL=3.5
# Skip Sept NFL / Oct NBA futures. 192 hours = 8 days to kickoff.
SX_MAX_KICKOFF_HOURS=192
# Empty-book 1000bp flicker: persistence below this AND move >= SX_FLICKER_BPS.
SX_MIN_PERSISTENCE=0.01
SX_FLICKER_BPS=800
# Watch in-play books for intel. Orders on live markets stay off unless SX_ALLOW_LIVE=true.
SX_WATCH_LIVE=true
SX_ALLOW_LIVE=false

# 100 bps = 1.00 implied-probability point.
SX_MIN_SPREAD_BPS=50
SX_MIN_MID_MOVE_BPS=20
SX_MIN_IMBALANCE=0.15
SX_JOIN_TICKS_BEHIND=1

SX_MAX_OPEN_MARKETS=8
SX_MAX_MARKETS=80
SX_MAX_EXPOSURE_USDC=100
SX_MAX_PER_MARKET_USDC=25
SX_POLL_SECONDS=2
SX_HEARTBEAT_SECONDS=60

SX_ENABLE_TAKE_STALE=true
SX_ENABLE_JOIN_MAKER=true
# join = sit behind makers (default)
# take = hit the informed side now (taker clone)
# mixed = take on strong steam, otherwise join
SX_FOLLOW_STYLE=join

# Your known sharp wallets. Visible on V2 only until Aug 25.
# After V3 the addresses vanish; `sxbot sharp` / `sxbot archive` learn their habits.
SX_SHARP_WALLETS=
SX_SHARP_LOG=sxbot-sharp.jsonl
SX_ARCHIVE_PATH=sxbot-history.sqlite

# Mimic paper bot (V2 only): copy new taker fills at SX_STAKE_USDC, skip longshots.
SX_MIMIC_MAX_DECIMAL=3.5
SX_MIMIC_COPY_MAKERS=true

SX_PAPER_LOG=sxbot-paper.jsonl
SX_FLOW_LOG=sxbot-flow.jsonl
SX_MIN_STEAM_HITS=2

# Paper taker Kelly (sxbot run with SX_FOLLOW_STYLE=take). 0.625 is between
# half-Kelly (moderate) and 3/4 Kelly (aggressive). Fair = book mid.
SX_BANKROLL_USDC=1000
SX_KELLY_FRACTION=0.625
SX_KELLY_MAX_FRAC=0.05
SX_KELLY_ON_TAKES=true

# Pregame two-sided maker: `sxbot mm` (separate from `sxbot run`).
# Join behind both bests until implied probs sum to < 100%. Paper fills
# only count when the public tape trades through our quote. Pull at kickoff.
# SX_MM_MAX_WIDEN_TICKS=6
# SX_MM_MIN_OVERROUND_BPS=25
# SX_MM_MIN_DECIMAL=1.12

# Live board: `sxbot board` then refresh http://127.0.0.1:8765
# 5k+ tape + paper feed, auto-refresh. Telegram is optional push, not the table.
SX_BOARD_HOST=127.0.0.1
SX_BOARD_PORT=8765
SX_BOARD_REFRESH_SECONDS=20
SX_BIG_FILL_USDC=5000
SX_TELEGRAM_TOKEN=
SX_TELEGRAM_CHAT_ID=

# Overlap (V2 only): `sxbot flow` / `run` tags each signal with who was quoting.
# Then `sxbot overlap` summarizes. Dies August 25.
